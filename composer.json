{
    "name": "henderjon/php-oidc",
    "description": "A small, dependency-light OpenID Connect client for PHP.",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "henderjon"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^7.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^2.0 || ^3.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "donatj/mock-webserver": "^2.10",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oidc\\": "test/"
        }
    }
}
